# .env.example — copy to .env and fill in real values
# Run with: ENV=local|staging|production npx playwright test

# Base URLs per environment
BASE_URL_LOCAL=https://opensource-demo.orangehrmlive.com
BASE_URL_STAGING=https://staging.orangehrmlive.com
BASE_URL_PRODUCTION=https://orangehrmlive.com

# Credentials
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123

# Timeouts (ms)
DEFAULT_TIMEOUT=30000
EXPECT_TIMEOUT=5000
